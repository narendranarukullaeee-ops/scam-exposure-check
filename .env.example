# Required in production (any long random string)
APP_SECRET=change-me
# Breach data: without a key the app runs in clearly-labelled SIMULATED mode
HIBP_API_KEY=
# Email one-time codes: console (dev only, logs the code) | brevo | resend
EMAIL_PROVIDER=console
MAIL_API_KEY=
MAIL_FROM=you@yourdomain.com
MAIL_FROM_NAME=Exposure Check
# Optional: plain-language summary. Leave blank to use the built-in template.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Abuse limits
DAILY_OTP_CAP=200
DAILY_GEMINI_CAP=300
IP_HOURLY_LIMIT=6
EMAIL_HOURLY_LIMIT=3
